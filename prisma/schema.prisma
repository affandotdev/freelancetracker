datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          String      @default("MEMBER") // SUPER_ADMIN | MEMBER
  createdAt     DateTime    @default(now())
  tasksAssigned  Task[]      @relation("AssignedTasks")
  objections     Objection[]
  issuesAssigned Issue[]     @relation("IssuesAssigned")
  issuesRaised   Issue[]     @relation("IssuesRaised")
  meetingsAssigned Meeting[] @relation("MeetingsAssigned")
  meetingsCreated  Meeting[] @relation("MeetingsCreated")
}

model Project {
  id              String       @id @default(cuid())
  name            String
  client          String?
  clientEmail     String?
  category        String?      @default("Web Development") // Web Development | UI/UX Design | Mobile App | Branding | SEO & Marketing | Maintenance | Other
  priority        String       @default("Medium")           // Low | Medium | High | Urgent
  status          String       @default("Not Started")      // Enquiry | Planning | Not Started | In Progress | On Hold | Completed
  progress        Int          @default(0)                  // 0-100
  totalAmount     Float        @default(0)                  // Total Contracted Value
  receivedAmount  Float        @default(0)                  // Amount Received So Far
  deadline        DateTime?
  description     String?
  attachments     Attachment[]
  tasks           Task[]
  commissions     Commission[]
  payments        Payment[]
  invoices        Invoice[]
  issues          Issue[]
  meetings        Meeting[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Task {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  assignedToId  String?
  assignedTo    User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  status        String       @default("To Do") // To Do | In Progress | In Review | Done | Blocked
  progress      Int          @default(0)       // 0-100
  deadline      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  objections    Objection[]
  updates       TaskUpdate[]

  @@index([projectId])
  @@index([assignedToId])
}

model TaskUpdate {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Objection {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User      @relation(fields: [raisedById], references: [id])
  message     String
  status      String    @default("Open") // Open | Resolved
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([taskId])
  @@index([raisedById])
}

model Attachment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("Quotation") // Quotation | Invoice | Contract | Receipt | Photo | Other
  mimeType    String
  size        Int      @default(0)           // file size in bytes
  fileData    String   @db.Text              // Base64 data URI or external URL
  isLink      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Commission {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beneficiary String
  amount      Float
  percentage  Float?
  status      String    @default("Pending") // Pending | Paid
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model Payment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  method      String   @default("Bank Transfer") // Cash | Bank Transfer | UPI | Cheque | Other
  note        String?
  paidOn      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Invoice {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique   // e.g. INV-0001, auto-incremented
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  amount         Float               // amount this invoice is for
  status         String   @default("Draft") // Draft | Sent | Paid
  notes          String?
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model Issue {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?   @db.Text
  module         String?   @default("User Side") // Admin Side | User Side | Client Portal | API / Backend | Public / Landing
  priority       String    @default("Medium") // Low | Medium | High | Critical
  status         String    @default("Open")   // Open | In Progress | Resolved | Closed
  resolution     String?   @db.Text
  path           String?   // Route, URL path, screen, or file path where bug occurs
  attachmentUrl  String?   @db.Text           // Base64 data URI, external URL, or JSON array of attachments
  attachmentName String?                      // Original file name or attachment label
  attachmentType String?                      // 'image' | 'video' | 'file' | 'multiple'
  raisedById     String
  raisedBy       User      @relation("IssuesRaised", fields: [raisedById], references: [id])
  assignedToId   String?
  assignedTo     User?     @relation("IssuesAssigned", fields: [assignedToId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  @@index([projectId])
  @@index([raisedById])
  @@index([assignedToId])
}

model Meeting {
  id               String    @id @default(cuid())
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientName       String
  clientEmail      String?
  clientPhone      String?
  title            String
  type             String    @default("Client Meeting") // Discovery Call | Requirement Gathering | Progress Review | Deliverable Walkthrough | Follow-up Check-in | Payment Follow-up | General
  platform         String    @default("Google Meet")    // Google Meet | Zoom | Microsoft Teams | Phone Call | In-Person | Other
  meetingLink      String?
  scheduledAt      DateTime
  durationMinutes  Int       @default(30)
  status           String    @default("Scheduled")      // Scheduled | Completed | Rescheduled | Cancelled
  agenda           String?   @db.Text
  notes            String?   @db.Text
  actionItems      String?   @db.Text
  outcome          String?                              // Positive - Approved | Revisions Requested | Decision Pending | Follow-up Required | Deal Closed | No Show
  nextFollowUpDate DateTime?
  assignedToId     String?
  assignedTo       User?     @relation("MeetingsAssigned", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?     @relation("MeetingsCreated", fields: [createdById], references: [id])
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([scheduledAt])
  @@index([status])
}

